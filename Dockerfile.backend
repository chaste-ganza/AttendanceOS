FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

WORKDIR /app

COPY requirements.txt ./requirements.txt
RUN pip install --no-cache-dir -r requirements.txt

COPY app.py auth_service.py database.py rfid_listener.py rfid_service.py rfid_state.py session_service.py card_management_service.py ./

EXPOSE 5000

CMD ["python", "app.py"]
